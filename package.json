{
    "name": "uptime-kuma-website",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "start": "node server.ts",
        "dev": "node --watch server.ts",
        "build": "npm --prefix frontend run build",
        "install-frontend": "npm --prefix frontend install",
        "dev-frontend": "npm --prefix frontend run dev",
        "csv-to-json": "node --env-file-if-exists=.env scripts/csv-to-json.ts",
        "sponsors:json": "node --env-file-if-exists=.env scripts/fetch-sponsors.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.5",
        "csv-parse": "^6.1.0",
        "hono": "^4.10.4",
        "sharp": "^0.35.5"
    }
}
